.login-section {
  padding: 60rpx 30rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 60rpx;
}

.login-form {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item.verify-code {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.form-input {
  height: 88rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.verify-btn {
  width: 220rpx;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #FF6B6B;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 0;
  border: none;
}

.verify-btn[disabled] {
  background-color: #cccccc;
}

.login-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-top: 40rpx;
}

.pickup-section {
  padding: 20rpx 30rpx;
}

.manager-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.manager-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.manager-phone {
  font-size: 26rpx;
  color: #999999;
  margin-left: 20rpx;
}

.logout-btn {
  font-size: 26rpx;
  color: #FF6B6B;
  margin-left: auto;
}

.action-bar {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.scan-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 16rpx;
  padding: 40rpx;
  border: none;
}

.scan-btn image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.scan-btn text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

.input-wrap {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.code-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 160rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f5f5f5;
  color: #333333;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.order-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.order-left {
  display: flex;
  flex-direction: column;
}

.order-user {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.order-code {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.order-quantity {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #999999;
  font-size: 26rpx;
}

.confirm-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.confirm-modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #eeeeee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.modal-body {
  padding: 30rpx;
}

.confirm-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.confirm-label {
  font-size: 28rpx;
  color: #999999;
}

.confirm-value {
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666666;
}

.confirm-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
}
.publish-page {
  padding: 24rpx 24rpx 160rpx;
}

.publish-hero,
.form-card,
.notice-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.publish-hero {
  margin-top: 0;
  background: linear-gradient(165deg, #ff7d73 0%, #ffa380 100%);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx rgba(255, 107, 107, 0.22);
}

.publish-hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.publish-hero-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.hero-tips {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.hero-tip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #25324a;
}

.form-item {
  padding-top: 26rpx;
}

.form-item.simple {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  font-size: 28rpx;
  color: #25324a;
  margin-bottom: 16rpx;
}

.form-item.simple .form-label {
  margin-bottom: 0;
}

.form-label.required::before {
  content: '*';
  color: #ff6b6b;
  margin-right: 8rpx;
}

.form-input,
.picker-value {
  height: 86rpx;
  line-height: 86rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #f4f6fb;
  font-size: 28rpx;
  color: #25324a;
}

.form-textarea {
  width: 100%;
  height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f4f6fb;
  font-size: 28rpx;
  color: #25324a;
  box-sizing: border-box;
}

.form-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #98a2b3;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.image-item,
.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
}

.image-item {
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff6b6b;
  color: #ffffff;
  font-size: 28rpx;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff7f4;
  border: 2rpx dashed rgba(255, 107, 107, 0.28);
}

.add-icon {
  font-size: 60rpx;
  line-height: 1;
  color: #ff6b6b;
}

.add-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 22rpx;
}

.notice-index {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff1ed;
  color: #ff6b6b;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
  box-shadow: 0 -12rpx 40rpx rgba(31, 41, 55, 0.08);
}

.bottom-price {
  width: 150rpx;
  display: flex;
  flex-direction: column;
}

.bottom-price-label {
  font-size: 22rpx;
  color: #98a2b3;
}

.bottom-price-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.publish-btn {
  flex: 1;
}

.publish-btn.loading,
.publish-btn[disabled] {
  opacity: 0.72;
}

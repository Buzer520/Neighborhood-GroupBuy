<view class="publish-page">
  <view class="publish-hero surface-card">
    <view class="publish-hero-title">发起一个更容易成团的拼单</view>
    <view class="publish-hero-desc">把商品信息写清楚、图片拍明白，邻居会更愿意下单。</view>
    <view class="hero-tips">
      <text class="hero-tip">小区：{{community}}</text>
      <text class="hero-tip">自提：{{pickupPoint || '待定'}}</text>
    </view>
  </view>

  <view class="surface-card form-card">
    <view class="block-title">商品信息</view>
    <view class="form-item">
      <view class="form-label required">商品名称</view>
      <input class="form-input" placeholder="例如：云南蓝莓 125g*4盒" value="{{productName}}" bindinput="onProductNameInput" maxlength="50" />
    </view>
    <view class="form-item">
      <view class="form-label required">商品图片</view>
      <view class="image-list">
        <view class="image-item" wx:for="{{productImages}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
          <view class="image-remove" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="image-add" bindtap="chooseImage" wx:if="{{productImages.length < 6}}">
          <text class="add-icon">+</text>
          <text class="add-text">{{uploading ? '上传中' : '添加图片'}}</text>
        </view>
      </view>
      <view class="form-tip">建议上传商品实拍或清晰宣传图，最多 6 张</view>
    </view>
    <view class="form-item">
      <view class="form-label required">规格描述</view>
      <input class="form-input" placeholder="例如：5斤装 / 单盒 24枚" value="{{spec}}" bindinput="onSpecInput" maxlength="30" />
    </view>
  </view>

  <view class="surface-card form-card">
    <view class="block-title">拼单规则</view>
    <view class="form-item">
      <view class="form-label required">期望拼单价</view>
      <input class="form-input" type="digit" placeholder="请输入最终期望成交价" value="{{targetPrice}}" bindinput="onTargetPriceInput" />
      <view class="form-tip">系统会自动生成阶梯价，成团人数越多价格越优惠</view>
    </view>
    <view class="form-item">
      <view class="form-label required">最小成团人数</view>
      <input class="form-input" type="number" placeholder="建议 5-20 人更易成团" value="{{targetCount}}" bindinput="onTargetCountChange" />
    </view>
    <view class="form-item">
      <view class="form-label required">拼单截止时间</view>
      <picker mode="selector" range="{{deadlineOptions}}" value="{{deadlineIndex}}" bindchange="onDeadlineChange">
        <view class="picker-value">{{deadlineOptions[deadlineIndex]}}</view>
      </picker>
    </view>
    <view class="form-item">
      <view class="form-label">补充说明</view>
      <textarea class="form-textarea" placeholder="补充口味、发货时间、挑选标准等说明" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" />
    </view>
  </view>

  <view class="surface-card form-card">
    <view class="block-title">提货信息</view>
    <view class="form-item simple">
      <view class="form-label">所属小区</view>
      <view class="picker-value">{{community}}</view>
    </view>
    <view class="form-item simple">
      <view class="form-label">默认自提点</view>
      <view class="picker-value">{{pickupPoint || '待定'}}</view>
    </view>
  </view>

  <view class="surface-card notice-card">
    <view class="block-title">发布建议</view>
    <view class="notice-item" wx:for="{{publishNotices}}" wx:key="*this">
      <text class="notice-index">{{index + 1}}</text>
      <text class="notice-text">{{item}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-price">
      <text class="bottom-price-label">诚意金</text>
      <text class="bottom-price-value">¥1.00</text>
    </view>
    <button class="btn-primary publish-btn {{loading ? 'loading' : ''}}" bindtap="publishGroupBuy" disabled="{{loading}}">
      <text wx:if="{{!loading}}">支付诚意金并发布</text>
      <text wx:if="{{loading}}">发布中...</text>
    </button>
  </view>
</view>

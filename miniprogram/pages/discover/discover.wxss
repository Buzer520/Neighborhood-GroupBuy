.discover-page {
  padding: 24rpx;
}

.discover-top {
  padding: 22rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-wrap {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: #f4f6fb;
  overflow: hidden;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  color: #25324a;
}

.search-submit {
  width: 120rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6b6b;
  font-size: 26rpx;
  font-weight: 700;
}

.filter-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.filter-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f6fb;
  color: #6b7280;
  font-size: 22rpx;
}

.filter-chip.strong {
  background: rgba(255, 107, 107, 0.12);
  color: #ff6b6b;
}

.filter-clear {
  margin-left: auto;
  font-size: 22rpx;
  color: #ff6b6b;
}

.category-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.05);
}

.category-pill.active {
  background: linear-gradient(135deg, #ff6b6b, #ff927a);
  color: #ffffff;
}

.category-pill-icon {
  font-size: 26rpx;
}

.result-bar {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.result-count {
  font-size: 24rpx;
  color: #98a2b3;
}

.discover-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.discover-card {
  display: flex;
  padding: 18rpx;
}

.discover-cover {
  width: 196rpx;
  height: 196rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}

.discover-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.discover-meta,
.discover-price-row,
.discover-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.discover-time,
.discover-sub,
.discover-remain,
.discover-count {
  font-size: 22rpx;
  color: #6b7280;
}

.discover-title {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #25324a;
}

.discover-sub {
  display: block;
  margin-top: 10rpx;
}

.discover-price-row {
  margin-top: 18rpx;
}

.discover-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.discover-bottom {
  margin-top: 14rpx;
}

.discover-link {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 600;
}

.status-tip {
  text-align: center;
  font-size: 24rpx;
  color: #98a2b3;
  padding: 24rpx 0;
}

.empty-card {
  padding: 40rpx 30rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #25324a;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

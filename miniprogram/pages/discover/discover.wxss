.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #666666;
}

.sort-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
}

.category-bar {
  background-color: #ffffff;
  padding: 0 0 20rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin: 0 10rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.category-item.active {
  background-color: rgba(255, 107, 107, 0.15);
  color: #FF6B6B;
  font-weight: bold;
}

.result-tip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  color: #999999;
}

.result-tip text {
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.content {
  height: calc(100vh - 200rpx);
  padding: 20rpx;
}

.waterfall {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.waterfall-item {
  width: calc(50% - 10rpx);
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.item-image {
  width: 100%;
  height: 320rpx;
}

.item-info {
  padding: 16rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: block;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-community {
  font-size: 20rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-progress {
  display: flex;
  align-items: center;
}

.progress-bar-small {
  width: 100rpx;
  height: 6rpx;
  background-color: #eeeeee;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF8E8E);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text-small {
  font-size: 20rpx;
  color: #999999;
  margin-left: 8rpx;
}

.item-countdown {
  font-size: 22rpx;
  color: #FF6B6B;
}

.loading-tip,
.no-more,
.empty-tip {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}
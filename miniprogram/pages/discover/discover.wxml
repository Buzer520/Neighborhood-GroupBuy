<view class="discover-page">
  <view class="discover-top surface-card">
    <view class="search-wrap">
      <input
        class="search-input"
        placeholder="搜商品名、需求关键词"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <view class="search-submit" bindtap="onSearchConfirm">搜索</view>
    </view>
    <view class="filter-row">
      <picker mode="selector" range="{{sortOptions}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="filter-chip strong">{{currentSortLabel}}</view>
      </picker>
      <view class="filter-chip" wx:if="{{keyword}}">关键词：{{keyword}}</view>
      <view class="filter-chip" wx:if="{{categoryName}}">{{categoryName}}</view>
      <view class="filter-clear" wx:if="{{keyword || categoryName || sortBy !== 'default'}}" bindtap="clearFilters">重置</view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="category-list">
      <view
        class="category-pill {{categoryId == item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onCategoryChange"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text class="category-pill-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="result-bar">
    <view>
      <view class="section-title">附近可拼好物</view>
      <view class="section-desc">按最新发布和剩余时间排序，方便快速决策</view>
    </view>
    <text class="result-count">{{resultCount}} 条</text>
  </view>

  <view class="discover-list">
    <view class="discover-card surface-card" wx:for="{{groupBuys}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <image class="discover-cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="discover-main">
        <view class="discover-meta">
          <text class="tag tag-gray">{{item.community}}</text>
          <text class="discover-time">{{item.countdownStr}}</text>
        </view>
        <text class="discover-title text-ellipsis-2">{{item.productName}}</text>
        <text class="discover-sub text-ellipsis">{{item.tierSummary || '邻里拼单中，人数越多价格越优'}}</text>
        <view class="discover-price-row">
          <text class="discover-price">¥{{item.currentPrice}}</text>
          <text class="discover-remain">{{item.remainingText}}</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.progress}}%"></view>
        </view>
        <view class="discover-bottom">
          <text class="discover-count">{{item.currentCount}} / {{item.targetCount}}人</text>
          <text class="discover-link">查看详情</text>
        </view>
      </view>
    </view>

    <view class="status-tip" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="status-tip" wx:if="{{showNoMore}}">
      <text>已经看完全部拼单了</text>
    </view>
    <view class="empty-card surface-card" wx:if="{{showEmpty}}">
      <text class="empty-title">暂无相关拼单</text>
      <text class="empty-desc">换个关键词试试，或者自己先发起一个。</text>
    </view>
  </view>
</view>

.banner-swiper {
  width: 100%;
  height: 500rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.info-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-header {
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
}

.product-spec {
  font-size: 26rpx;
  color: #999999;
  margin-top: 10rpx;
}

.creator-info {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eeeeee;
}

.creator-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.creator-detail {
  flex: 1;
  margin-left: 16rpx;
}

.creator-name {
  font-size: 28rpx;
  color: #333333;
  display: block;
}

.creator-label {
  font-size: 22rpx;
  color: #999999;
}

.community-tag {
  font-size: 24rpx;
}

.progress-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.progress-count {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.progress-bar {
  height: 16rpx;
  background-color: #eeeeee;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF8E8E);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 24rpx;
  color: #FF6B6B;
  text-align: right;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.price-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.tiered-prices {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tier-item {
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.tier-item.active {
  background-color: rgba(255, 107, 107, 0.1);
  border-color: #FF6B6B;
}

.tier-count {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.tier-item.active .tier-count {
  color: #FF6B6B;
}

.tier-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-top: 4rpx;
}

.tier-item.active .tier-price {
  color: #FF6B6B;
}

.current-price-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eeeeee;
}

.current-price-label {
  font-size: 28rpx;
  color: #666666;
}

.current-price {
  font-size: 48rpx;
  font-weight: bold;
}

.countdown-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.countdown-wrap {
  text-align: center;
}

.countdown-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.countdown-text.expired {
  color: #999999;
}

.participants-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 120rpx;
}

.participants-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.participant-item {
  width: 72rpx;
  height: 72rpx;
}

.participant-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #FF6B6B;
}

.participant-empty {
  width: 100%;
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
}

.pickup-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.pickup-info {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.pickup-name {
  font-size: 28rpx;
  color: #333333;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.bottom-left {
  width: 120rpx;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  padding: 0;
  line-height: 1.2;
  background: none;
}

.share-btn image {
  width: 40rpx;
  height: 40rpx;
}

.share-btn text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
}

.bottom-right {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.join-btn,
.invite-btn,
.my-order-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 60rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.join-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  border: none;
}

.invite-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  border: none;
}

.my-order-btn {
  background-color: #f5f5f5;
  color: #666666;
  border: none;
}

.join-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.join-modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.join-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
}

.pay-type-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.pay-tab {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666666;
}

.pay-tab.active {
  background-color: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
  font-weight: bold;
}

.quantity-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #333333;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333333;
}

.quantity-input {
  width: 80rpx;
  height: 56rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.amount-info {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
  color: #666666;
}

.amount-row.total {
  border-top: 1rpx solid #eeeeee;
  margin-top: 10rpx;
  padding-top: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.confirm-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}
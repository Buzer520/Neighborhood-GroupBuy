.detail-page {
  padding: 0 24rpx 160rpx;
}

.banner-swiper {
  width: 100%;
  height: 520rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.overview-card,
.section-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.overview-tags {
  display: flex;
  gap: 12rpx;
}

.product-name {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #25324a;
}

.product-spec {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f4f6fb;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
}

.price-row {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.price-caption,
.deadline-label {
  display: block;
  font-size: 22rpx;
  color: #98a2b3;
}

.price-main {
  margin-top: 12rpx;
  color: #ff6b6b;
}

.deadline-card {
  min-width: 220rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #fff5f3;
}

.deadline-value {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.deadline-value.expired {
  color: #98a2b3;
}

.creator-bar {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf0f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.creator-left {
  display: flex;
  align-items: center;
}

.creator-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.creator-detail {
  margin-left: 16rpx;
}

.creator-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #25324a;
}

.creator-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #98a2b3;
}

.creator-tip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f6fb;
  font-size: 22rpx;
  color: #6b7280;
}

.progress-count {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: 700;
}

.progress-foot {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #6b7280;
}

.tiered-prices {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.tier-item {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #f4f6fb;
  border: 2rpx solid transparent;
}

.tier-item.active {
  border-color: rgba(255, 107, 107, 0.3);
  background: #fff3f0;
}

.tier-count,
.tier-price {
  display: block;
}

.tier-count {
  font-size: 22rpx;
  color: #98a2b3;
}

.tier-price {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #25324a;
}

.tier-item.active .tier-count,
.tier-item.active .tier-price {
  color: #ff6b6b;
}

.participants-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
}

.participant-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.participant-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #fff1ed;
}

.participant-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.participant-empty {
  padding: 34rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  text-align: center;
  font-size: 24rpx;
  color: #98a2b3;
}

.info-line {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
}

.info-label {
  width: 100rpx;
  font-size: 24rpx;
  color: #98a2b3;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #25324a;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
  box-shadow: 0 -12rpx 40rpx rgba(31, 41, 55, 0.08);
}

.bottom-side {
  width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7280;
}

.bottom-side-icon {
  font-size: 34rpx;
  line-height: 1;
}

.bottom-side-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.bottom-main {
  flex: 1;
}

.join-btn {
  width: 100%;
}

.join-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.25s ease;
}

.join-modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
}

.modal-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 24rpx 40rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.join-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header,
.quantity-wrap,
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #25324a;
}

.modal-close {
  font-size: 40rpx;
  line-height: 1;
  color: #98a2b3;
}

.pay-type-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.pay-tab {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  text-align: center;
  background: #f4f6fb;
  color: #6b7280;
  font-size: 26rpx;
}

.pay-tab.active {
  background: #fff0ec;
  color: #ff6b6b;
  font-weight: 700;
}

.quantity-wrap {
  margin-top: 28rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #25324a;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.quantity-btn,
.quantity-input {
  width: 70rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #f4f6fb;
  font-size: 30rpx;
  color: #25324a;
}

.quantity-btn.active {
  background: #fff0ec;
  color: #ff6b6b;
}

.amount-info {
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.amount-row {
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #6b7280;
}

.amount-row.total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0f5;
  font-size: 30rpx;
  font-weight: 700;
  color: #25324a;
}

.confirm-btn {
  margin-top: 28rpx;
}

<view class="detail-page" wx:if="{{groupBuy}}">
  <swiper class="banner-swiper" indicator-dots circular autoplay>
    <swiper-item wx:for="{{groupBuy.productImages}}" wx:key="*this">
      <image class="banner-image" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="overview-card surface-card">
    <view class="overview-tags">
      <text class="tag tag-primary">{{groupBuy.community}}</text>
      <text class="tag tag-gray">{{groupBuy.statusText}}</text>
    </view>
    <text class="product-name">{{groupBuy.productName}}</text>
    <text class="product-spec" wx:if="{{groupBuy.spec}}">{{groupBuy.spec}}</text>
    <view class="price-row">
      <view>
        <text class="price-caption">当前拼单价</text>
        <view class="price-main">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{currentPrice}}</text>
        </view>
      </view>
      <view class="deadline-card">
        <text class="deadline-label">剩余时间</text>
        <text class="deadline-value {{countdown === '已结束' ? 'expired' : ''}}">{{countdown}}</text>
      </view>
    </view>
    <view class="creator-bar">
      <view class="creator-left">
        <image class="creator-avatar" src="{{creator.avatarUrl}}" mode="aspectFill" />
        <view class="creator-detail">
          <text class="creator-name">{{creator.nickName || '热心团长'}}</text>
          <text class="creator-label">发起人 · 邻里认证用户</text>
        </view>
      </view>
      <view class="creator-tip">靠谱发起</view>
    </view>
  </view>

  <view class="surface-card section-card">
    <view class="section-header">
      <view>
        <view class="section-title">拼单进度</view>
        <view class="section-desc">离成团还差 {{groupBuy.remainingCount}} 人，快邀请邻居一起拼</view>
      </view>
      <text class="progress-count">{{groupBuy.currentCount}}/{{groupBuy.targetCount}}人</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <view class="progress-foot">
      <text>{{progress}}% 已达成</text>
      <text>{{groupBuy.remainingText}}</text>
    </view>
  </view>

  <view class="surface-card section-card">
    <view class="section-header">
      <view>
        <view class="section-title">阶梯价格</view>
        <view class="section-desc">参与人数越多，价格越划算</view>
      </view>
    </view>
    <view class="tiered-prices">
      <view class="tier-item {{groupBuy.currentCount >= item.min ? 'active' : ''}}" wx:for="{{groupBuy.tieredPrices}}" wx:key="min">
        <text class="tier-count">满{{item.min}}人</text>
        <text class="tier-price">¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <view class="surface-card section-card">
    <view class="section-header">
      <view>
        <view class="section-title">参与情况</view>
        <view class="section-desc">已经加入的邻居会显示在这里</view>
      </view>
    </view>
    <view class="participants-list" wx:if="{{participants.length > 0}}">
      <view class="participant-item" wx:for="{{participants}}" wx:key="_id">
        <image class="participant-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <text class="participant-name">{{item.nickName || '邻居'}}</text>
      </view>
    </view>
    <view class="participant-empty" wx:else>
      <text>还没有人参与，你可以成为第一个下单的人。</text>
    </view>
  </view>

  <view class="surface-card section-card" wx:if="{{groupBuy.pickupPoint || groupBuy.remark}}">
    <view class="section-header">
      <view>
        <view class="section-title">提货与说明</view>
        <view class="section-desc">下单前建议先确认自提点和补充说明</view>
      </view>
    </view>
    <view class="info-line" wx:if="{{groupBuy.pickupPoint}}">
      <text class="info-label">自提点</text>
      <text class="info-value">{{groupBuy.pickupPoint}}</text>
    </view>
    <view class="info-line" wx:if="{{groupBuy.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{groupBuy.remark}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-side" bindtap="goToShare">
      <text class="bottom-side-icon">↗</text>
      <text class="bottom-side-text">转发</text>
    </view>
    <view class="bottom-main">
      <button class="btn-primary join-btn" wx:if="{{!hasJoined && !isCreator}}" bindtap="showJoinModal">立即参与</button>
      <button class="btn-secondary join-btn" wx:if="{{hasJoined && !isCreator}}" bindtap="goToMyOrder">查看订单</button>
      <button class="btn-secondary join-btn" wx:if="{{isCreator}}" bindtap="goToShare">继续邀请</button>
    </view>
  </view>

  <view class="join-modal {{showJoinModal ? 'show' : ''}}" wx:if="{{showJoinModal}}">
    <view class="modal-mask" bindtap="hideJoinModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">选择参与方式</text>
        <text class="modal-close" bindtap="hideJoinModal">×</text>
      </view>

      <view class="pay-type-tabs">
        <view class="pay-tab {{currentTab === 'deposit' ? 'active' : ''}}" bindtap="selectPayType" data-type="deposit">支付定金 30%</view>
        <view class="pay-tab {{currentTab === 'full' ? 'active' : ''}}" bindtap="selectPayType" data-type="full">支付全款</view>
      </view>

      <view class="quantity-wrap">
        <text class="quantity-label">购买份数</text>
        <view class="quantity-control">
          <text class="quantity-btn" bindtap="onQuantityChange" data-action="minus">-</text>
          <input class="quantity-input" type="number" value="{{quantity}}" bindinput="onQuantityChange" />
          <text class="quantity-btn active" bindtap="onQuantityChange" data-action="plus">+</text>
        </view>
      </view>

      <view class="amount-info">
        <view class="amount-row">
          <text>单价</text>
          <text>¥{{currentPrice}}</text>
        </view>
        <view class="amount-row">
          <text>份数</text>
          <text>x{{quantity}}</text>
        </view>
        <view class="amount-row total">
          <text>{{currentTab === 'deposit' ? '本次应付' : '应付金额'}}</text>
          <text class="text-price">¥{{calculateAmount()}}</text>
        </view>
      </view>

      <button class="btn-primary confirm-btn" bindtap="joinGroupBuy">确认参与</button>
    </view>
  </view>
</view>

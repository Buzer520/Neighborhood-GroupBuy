<view class="mine-page">
  <view class="profile-card surface-card">
    <view class="user-info" wx:if="{{hasUserInfo}}">
      <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="user-meta">
        <text class="user-nickname">{{userInfo.nickName}}</text>
        <text class="user-tip">欢迎回来，看看今天有哪些新拼单</text>
      </view>
    </view>
    <view class="user-info" wx:else>
      <view class="guest-meta">
        <text class="user-nickname">登录后查看订单和发起记录</text>
        <text class="user-tip">授权一次即可同步昵称与头像</text>
      </view>
      <button class="btn-primary login-btn" bindtap="onLoginTap">立即登录</button>
    </view>
  </view>

  <view class="surface-card order-section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <picker mode="selector" range="{{orderStatus}}" value="0" range-key="label" bindchange="onOrderStatusChange">
        <text class="section-more">{{currentStatusLabel}} ▾</text>
      </picker>
    </view>

    <view class="tab-bar">
      <view class="tab-item {{currentOrderTab === 'joined' ? 'active' : ''}}" bindtap="onOrderTabChange" data-value="joined">我参与的</view>
      <view class="tab-item {{currentOrderTab === 'created' ? 'active' : ''}}" bindtap="onOrderTabChange" data-value="created">我发起的</view>
    </view>

    <view class="order-list" wx:if="{{currentOrderTab === 'joined'}}">
      <view class="order-item" wx:for="{{myOrders}}" wx:key="_id" bindtap="goToDetail" data-id="{{item.groupId}}">
        <image class="order-image" src="{{item.groupInfo.productImages[0]}}" mode="aspectFill" />
        <view class="order-info">
          <text class="order-name text-ellipsis">{{item.groupInfo.productName}}</text>
          <text class="order-status tag tag-primary">{{item.statusText}}</text>
        </view>
        <view class="order-meta">
          <text class="order-price text-price">¥{{item.unitPrice}}</text>
          <text class="order-quantity">x{{item.quantity}}</text>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{showOrderEmpty}}">
        <text>你还没有参与过拼单</text>
      </view>
    </view>

    <view class="order-list" wx:if="{{currentOrderTab === 'created'}}">
      <view class="order-item" wx:for="{{myGroupBuys}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
        <image class="order-image" src="{{item.productImages[0]}}" mode="aspectFill" />
        <view class="order-info">
          <text class="order-name text-ellipsis">{{item.productName}}</text>
          <text class="order-status tag tag-primary">{{item.statusText}}</text>
        </view>
        <view class="order-meta">
          <text class="order-price text-price">¥{{item.targetPrice}}</text>
          <text class="order-count">{{item.currentCount}}/{{item.targetCount}}人</text>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{showGroupEmpty}}">
        <text>你还没有发起过拼单</text>
      </view>
    </view>
  </view>

  <view class="surface-card menu-section">
    <view class="menu-item" bindtap="goToAddresses">
      <image class="menu-icon" src="/assets/images/address.png" mode="aspectFit" />
      <text class="menu-text">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToDepositLog">
      <image class="menu-icon" src="/assets/images/deposit.png" mode="aspectFit" />
      <text class="menu-text">诚意金记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToPickup">
      <image class="menu-icon" src="/assets/images/pickup.png" mode="aspectFit" />
      <text class="menu-text">团长核销</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item vip">
      <image class="menu-icon" src="/assets/images/vip.png" mode="aspectFit" />
      <text class="menu-text">VIP会员</text>
      <text class="menu-tag">即将开放</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <image class="menu-icon" src="/assets/images/settings.png" mode="aspectFit" />
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

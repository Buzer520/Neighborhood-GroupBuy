.mine-page {
  padding: 24rpx 24rpx 40rpx;
}

.profile-card,
.order-section,
.menu-section {
  margin-top: 22rpx;
}

.profile-card {
  margin-top: 0;
  padding: 28rpx;
  background: linear-gradient(160deg, #ff786f 0%, #ffa47f 100%);
  box-shadow: 0 24rpx 50rpx rgba(255, 107, 107, 0.24);
}

.user-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-meta,
.guest-meta {
  flex: 1;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  margin-right: 22rpx;
}

.user-nickname {
  display: block;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 700;
}

.user-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.login-btn {
  width: 220rpx;
  flex-shrink: 0;
  background: #ffffff;
  color: #ff6b6b;
  box-shadow: none;
}

.order-section {
  overflow: hidden;
  padding: 8rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #25324a;
}

.section-more {
  font-size: 26rpx;
  color: #98a2b3;
}

.tab-bar {
  display: flex;
  padding: 0 20rpx 12rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 999rpx;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: 700;
  background: #fff0ec;
}

.order-list {
  padding: 20rpx;
}

.order-item {
  display: flex;
  padding: 20rpx;
  background-color: #f8fafc;
  border-radius: 22rpx;
  margin-bottom: 16rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.order-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-name {
  font-size: 28rpx;
  color: #25324a;
  font-weight: 500;
  display: block;
}

.order-status {
  font-size: 22rpx;
  margin-top: 10rpx;
  display: inline-block;
  width: fit-content;
}

.order-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.order-price {
  font-size: 32rpx;
  font-weight: bold;
}

.order-quantity,
.order-count {
  font-size: 24rpx;
  color: #98a2b3;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #98a2b3;
  font-size: 26rpx;
}

.menu-section {
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #25324a;
}

.menu-arrow {
  font-size: 28rpx;
  color: #c2c8d0;
}

.menu-tag {
  font-size: 22rpx;
  color: #999999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.menu-item.vip .menu-text {
  color: #ff6b6b;
  font-weight: 500;
}

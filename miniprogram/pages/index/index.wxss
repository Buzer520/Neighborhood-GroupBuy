.home-page {
  padding: 24rpx 24rpx 40rpx;
}

.hero {
  padding: 28rpx;
  background: linear-gradient(165deg, #ff786f 0%, #ff9a7d 100%);
  color: #ffffff;
  box-shadow: 0 24rpx 50rpx rgba(255, 107, 107, 0.25);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.community-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.community-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.community-name {
  font-size: 28rpx;
  font-weight: 600;
}

.community-arrow {
  font-size: 20rpx;
}

.hero-action {
  padding: 14rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 28rpx;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.search-box {
  margin-top: 26rpx;
  height: 88rpx;
  background: #ffffff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  overflow: hidden;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #25324a;
}

.search-trigger {
  width: 96rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  width: 38rpx;
  height: 38rpx;
}

.metric-row {
  margin-top: 26rpx;
  display: flex;
  gap: 16rpx;
}

.metric-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 22rpx;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
}

.metric-label {
  font-size: 22rpx;
  opacity: 0.84;
}

.metric-value {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.metric-accent {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.84;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 20rpx;
  margin-top: 24rpx;
}

.quick-item {
  position: relative;
  min-height: 148rpx;
  padding: 24rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff7f4 0%, #fff 100%);
}

.quick-tag {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 107, 0.12);
  color: #ff6b6b;
  font-size: 20rpx;
}

.quick-title {
  margin-top: 18rpx;
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #25324a;
}

.quick-desc {
  margin-top: 10rpx;
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6b7280;
}

.hot-scroll {
  white-space: nowrap;
}

.hot-card {
  position: relative;
  width: 440rpx;
  margin-right: 20rpx;
  display: inline-block;
  overflow: hidden;
  vertical-align: top;
}

.hot-image {
  width: 100%;
  height: 260rpx;
}

.hot-overlay {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  right: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hot-status,
.hot-countdown {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.36);
  color: #ffffff;
  font-size: 20rpx;
}

.hot-body {
  padding: 22rpx;
}

.hot-name {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
  color: #25324a;
  min-height: 84rpx;
}

.hot-price-row,
.hot-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hot-price-row {
  margin-top: 18rpx;
}

.hot-price {
  font-size: 42rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.hot-progress-text,
.hot-community,
.hot-remain {
  font-size: 22rpx;
  color: #6b7280;
}

.hot-foot {
  margin-top: 14rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  padding: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 12rpx;
  border-radius: 22rpx;
  background: #fff8f6;
}

.category-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 107, 0.08);
}

.category-name {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #25324a;
}

.category-subtitle {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8b95a7;
}

.list-wrap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.list-card {
  display: flex;
  padding: 18rpx;
}

.list-cover {
  width: 196rpx;
  height: 196rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}

.list-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.list-top,
.list-price-row,
.list-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-time,
.list-sub,
.list-price-tip,
.list-count {
  font-size: 22rpx;
  color: #6b7280;
}

.list-title {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #25324a;
}

.list-sub {
  display: block;
  margin-top: 12rpx;
}

.list-price-row {
  margin-top: 18rpx;
}

.list-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.list-bottom {
  margin-top: 14rpx;
}

.list-cta {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 600;
}

.status-tip {
  text-align: center;
  font-size: 24rpx;
  color: #98a2b3;
  padding: 24rpx 0;
}

.empty-card {
  padding: 40rpx 30rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #25324a;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.empty-btn {
  margin-top: 28rpx;
}

.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #FF6B6B;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #FF6B6B;
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 16rpx;
  right: 60rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: #FF6B6B;
  border-radius: 50%;
}

.tab-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
  background-color: #f5f5f5;
}

.tab-actions text {
  font-size: 24rpx;
  color: #FF6B6B;
}

.message-list {
  height: calc(100vh - 180rpx);
  padding: 20rpx 30rpx;
}

.message-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.message-item.read {
  opacity: 0.7;
}

.message-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.message-icon image {
  width: 48rpx;
  height: 48rpx;
}

.message-content {
  flex: 1;
  margin-left: 20rpx;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.message-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.message-time {
  font-size: 22rpx;
  color: #999999;
}

.message-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
}

.message-footer {
  margin-top: 10rpx;
}

.message-link {
  font-size: 24rpx;
  color: #FF6B6B;
}

.unread-dot {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #FF6B6B;
  border-radius: 50%;
}

.loading-tip,
.no-more,
.empty-tip {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.empty-tip image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}
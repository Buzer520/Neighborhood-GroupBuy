page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
}

.flex {
  display: flex;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-col {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-around {
  justify-content: space-around;
  align-items: center;
}

.flex-start {
  justify-content: flex-start;
  align-items: center;
}

.flex-end {
  justify-content: flex-end;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.flex-2 {
  flex: 2;
}

.flex-3 {
  flex: 3;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-left {
  text-align: left;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.text-price {
  color: #FF6B6B;
  font-weight: bold;
}

.text-gray {
  color: #999999;
}

.text-light {
  color: #cccccc;
}

.text-bold {
  font-weight: bold;
}

.text-size-24 {
  font-size: 24rpx;
}

.text-size-26 {
  font-size: 26rpx;
}

.text-size-28 {
  font-size: 28rpx;
}

.text-size-30 {
  font-size: 30rpx;
}

.text-size-32 {
  font-size: 32rpx;
}

.text-size-36 {
  font-size: 36rpx;
}

.text-size-40 {
  font-size: 40rpx;
}

.text-size-48 {
  font-size: 48rpx;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.mr-10 {
  margin-right: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.pt-20 {
  padding-top: 20rpx;
}

.pt-30 {
  padding-top: 30rpx;
}

.pb-20 {
  padding-bottom: 20rpx;
}

.pb-30 {
  padding-bottom: 30rpx;
}

.p-20 {
  padding: 20rpx;
}

.p-30 {
  padding: 30rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.btn-primary {
  background-color: #FF6B6B;
  color: #ffffff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background-color: #ffffff;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-disabled {
  background-color: #cccccc;
  color: #ffffff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.input-wrap {
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.input-wrap input {
  width: 100%;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.tag-primary {
  background-color: rgba(255, 107, 107, 0.15);
  color: #FF6B6B;
}

.tag-success {
  background-color: rgba(76, 175, 80, 0.15);
  color: #4CAF50;
}

.tag-warning {
  background-color: rgba(255, 193, 7, 0.15);
  color: #FFC107;
}

.tag-gray {
  background-color: rgba(153, 153, 153, 0.15);
  color: #999999;
}

.divider {
  height: 1rpx;
  background-color: #eeeeee;
  margin: 30rpx 0;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
}

.price-decimal {
  font-size: 24rpx;
}
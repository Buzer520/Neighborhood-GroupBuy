page {
  background: #f6f7fb;
  font-size: 28rpx;
  color: #25324a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --brand-primary: #ff6b6b;
  --brand-secondary: #ff8f7a;
  --brand-soft: #fff1ed;
  --page-bg: #f6f7fb;
  --card-bg: #ffffff;
  --text-main: #25324a;
  --text-sub: #6b7280;
  --text-light: #98a2b3;
  --line-soft: #edf0f5;
  --shadow-card: 0 14rpx 40rpx rgba(31, 41, 55, 0.08);
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.surface-card {
  background: var(--card-bg);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
}

.section-block {
  margin-top: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-link {
  font-size: 24rpx;
  color: var(--brand-primary);
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-price {
  color: var(--brand-primary);
  font-weight: 700;
}

.text-gray {
  color: var(--text-sub);
}

.text-light {
  color: var(--text-light);
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.tag-primary {
  background: rgba(255, 107, 107, 0.14);
  color: var(--brand-primary);
}

.tag-success {
  background: rgba(41, 204, 151, 0.14);
  color: #16a34a;
}

.tag-warning {
  background: rgba(250, 173, 20, 0.14);
  color: #d97706;
}

.tag-gray {
  background: #f3f5f8;
  color: #667085;
}

.btn-primary,
.btn-secondary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  border: none;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));
  box-shadow: 0 16rpx 30rpx rgba(255, 107, 107, 0.22);
}

.btn-secondary {
  color: var(--brand-primary);
  background: #ffffff;
  border: 2rpx solid rgba(255, 107, 107, 0.24);
}

.input-wrap {
  background: #f4f6fb;
  border-radius: 22rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.input-wrap input,
.input-wrap textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-main);
}

.progress-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-primary), var(--brand-secondary));
}

.price-symbol {
  font-size: 22rpx;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
}
